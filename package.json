{
  "name": "velonexo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "demo:prepare": ".venv/bin/python scripts/prepare_demo.py",
    "test": "node scripts/run_checks.cjs",
    "test:remote": "node scripts/run_checks.cjs --remote",
    "media": ".venv/bin/python scripts/media_publish.py",
    "test:studio": "node tests/browser/studio-check.cjs",
    "test:studio:recovery": "node tests/server/studio-recovery.mjs",
    "test:studio:operations": "node tests/browser/studio-operations.cjs",
    "test:studio:storage": "node tests/browser/studio-storage.cjs",
    "test:studio:backups": "node tests/browser/studio-backups.cjs",
    "build:static": "VITE_STATIC_EXPORT=1 npm run build && .venv/bin/python scripts/export_static.py",
    "test:delivery": "node scripts/run_delivery_checks.cjs",
    "setup:local": "python3 scripts/setup_local.py",
    "check:repo": ".venv/bin/python scripts/check_repository.py"
  },
  "dependencies": {
    "@zyncat/ui": "0.21.0",
    "hls.js": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
